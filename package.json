{
  "name": "njupt-search",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "academics/exam",
    "search/browser"
  ],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "build": "npm run build:wasm:web && npm run build:prepared",
    "build:prepared": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build --config apps/web/vite.config.ts && node ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.app.json ops/render-seo-pages.tsx",
    "build:wasm:web": "wasm-pack build search/wasm --target web --release --out-dir ../browser/wasm",
    "academics:build": "uv run python -m academics.exam",
    "academics:validate": "node ./node_modules/tsx/dist/cli.mjs ops/validate-academics.ts",
    "seo:validate": "node ops/validate-seo.mjs",
    "search:test": "cargo test --manifest-path search/Cargo.toml --workspace",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "node ./node_modules/vite/bin/vite.js preview --config apps/web/vite.config.ts",
    "test": "npm run search:test && npm run build:wasm:web && npm run test:prepared && uv run pytest academics/exam academics/room/occupancy academics/timetable -q",
    "test:prepared": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "typecheck": "npm run build:wasm:web && npm run typecheck:prepared",
    "typecheck:prepared": "node ./node_modules/typescript/bin/tsc -b --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.4",
    "vitest": "^4.1.7"
  }
}
